# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/

# Packaging / build outputs. Anchored to the repository root so that the
# tracked frontend bundle in app/web/dist/ (and future rebuilds of it) is not
# silently ignored; whether to keep tracking it is a separate decision.
*.egg-info/
/build/
/dist/
/wheelhouse/
*.whl

# Native extension artefacts
*.so
*.pyd
cpp/build*/
/build-cpp/
cpp/.cmake/
cpp/.skbuild-info.json

# Perf comparison runs (benchmarks/compare_backends.py); only committed baselines are tracked
benchmarks/results/*.json
!benchmarks/results/baseline-*.json

# Coverage
.coverage*
htmlcov/
coverage*.xml

# Front end caches (node_modules and dist are intentionally tracked today)
app/web/node_modules/.vite/
app/web/.vite/

# Editors / OS
.DS_Store
Thumbs.db

# Claude Code agent worktrees
.claude/worktrees/
